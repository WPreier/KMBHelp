# Workstation template. Copy with: cp .env.example .env
# Secrets stay empty. On this PC they belong in %LOCALAPPDATA%\kmbhelp\secrets.json.
# On kmbhelp they belong in /etc/kmbhelp/kmbhelp.env. The server template is infra/kmbhelp.env.example.
# A non-secret saved on the configuration page overrides this file on the next start.
# NODE_ENV is not set here. API_HOST and PUBLIC_ORIGIN describe this PC, not the server.

ACCESS_LOG_RETENTION_DAYS=90
ACTIVITY_LOG_FILE=
ADMIN_IP_ALLOWLIST=192.168.36.0/24,192.168.191.0/24
ALLOW_TEST_AUTH=
API_HOST=127.0.0.1
API_PORT=3000
CALENDAR_DEFAULT_MINUTES=30
CALENDAR_DELAY_P1=0
CALENDAR_DELAY_P2=60
CALENDAR_DELAY_P3=240
DATABASE_URL=postgresql://postgres:replace-me@127.0.0.1:5432/kmbhelp
EMAIL_AUTH_DOMAINS=kmbcloud.at,kmb-steuerberatung.at,krottendorfer.com,ght.at
FALLBACK_CATEGORY=printer
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
