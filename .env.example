# Names only. Real values belong in .env on the machine, never in git.
# Local PostgreSQL: see the docker command in ENTWICKLUNGSUMGEBUNG.md.

DATABASE_URL=postgresql://postgres:replace-me@127.0.0.1:5432/kmbhelp
API_HOST=127.0.0.1
API_PORT=3000

# Session key from phase 3. Long random value.
SESSION_SECRET=

# Must stay unset in production. Phase 2 test header.
ALLOW_TEST_AUTH=

# Comma-separated client addresses. Phase 3 admin routes.
# Decided nets: 192.168.36.0/24 and 192.168.191.0/24. The value stays on the machine.
ADMIN_IP_ALLOWLIST=

# Microsoft Graph. Leave empty until admin consent exists. Phase 4.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_MAILBOX=helpdesk@kmbcloud.at

# Passkey relying party. Empty uses helpdesk.kmbcloud.at in production and 127.0.0.1 locally.
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGIN=

# Syslog UDP. Delivery defaults are localhost and port 514. See ConfigDefaults.md.
SYSLOG_HOST=127.0.0.1
SYSLOG_PORT=514

# LDAPS. Service account, not a domain admin. Group HelpdeskAdmins.
# DN: CN=HelpdeskAdmins,OU=Sicherheitsgruppen,OU=kmb,DC=kmbcloud,DC=at
LDAPS_URL=ldaps://MADC1.kmbcloud.at:636
LDAPS_BIND_DN=
LDAPS_BIND_PASSWORD=
LDAPS_BASE_DN=
LDAPS_GROUP_DN=
LDAPS_CA_FILE=

# Model provider. No model call until endpoint, region and AVV are set. Phase 6.
AI_ENDPOINT=
AI_REGION=
AI_API_KEY=
AI_AVV_REFERENCE=

# Header links. Empty until the firm names the real addresses.
VITE_PUBLIC_URL_WWW=https://kmb-steuerberatung.at
VITE_PUBLIC_URL_HOME=https://home.kmbcloud.at
VITE_PUBLIC_URL_WIKI=https://wiki.kmbcloud.at

# Asked once by scripts/install.ts, then remove the value from shell history.
LOCAL_ADMIN_USERNAME=
LOCAL_ADMIN_PASSWORD=
