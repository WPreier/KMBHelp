# Server template for /etc/kmbhelp/kmbhelp.env.
# Root owns the real file, group kmbhelp, mode 0640. It stays out of git and is not replaced by an update.
# NODE_ENV is set by the systemd unit. Leave it out of this file.
# API_HOST is the internal address of this server. The placeholder 192.0.2.10 is not that address.
# 127.0.0.1 would make every visitor look like localhost.
# The workstation template, with 127.0.0.1 and http://127.0.0.1:5173, is .env.example.
# VITE_PUBLIC_URL_* are read from /opt/kmbhelp/.env when the website is built.

ACCESS_LOG_RETENTION_DAYS=90
ACTIVITY_LOG_FILE=/var/lib/kmbhelp/activity.log
ADMIN_IP_ALLOWLIST=192.168.36.0/24,192.168.191.0/24,192.0.2.10
ALLOW_TEST_AUTH=
API_HOST=192.0.2.10
API_PORT=3000
CALENDAR_DEFAULT_MINUTES=30
CALENDAR_DELAY_P1=0
CALENDAR_DELAY_P2=60
CALENDAR_DELAY_P3=240
DATABASE_URL=postgresql://kmbhelp:replace-me@127.0.0.1:5432/kmbhelp
EMAIL_AUTH_DOMAINS=kmbcloud.at,kmb-steuerberatung.at,krottendorfer.com,ght.at
FALLBACK_CATEGORY=printer
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_MAILBOX=helpdesk@kmbcloud.at
GRAPH_TENANT_ID=
INTERNAL_MAIL_DOMAINS=kmb-steuerberatung.at,ght.at,koller-rohrschach.at
LDAPS_BASE_DN=DC=kmbcloud,DC=at
LDAPS_BIND_DN=
LDAPS_BIND_PASSWORD=
LDAPS_CA_FILE=/etc/kmbhelp/madc1.crt
LDAPS_CA_PEM=
LDAPS_GROUP_DN=CN=HelpdeskAdmins,OU=Sicherheitsgruppen,OU=kmb,DC=kmbcloud,DC=at
LDAPS_URL=ldaps://MADC1.kmbcloud.at:636
LOCAL_ADMIN_PASSWORD=
LOCAL_ADMIN_USERNAME=
LOG_ROTATE_DAYS=30
MAIL_AI_PROMPT=
MAIL_ERROR_TO=helpdesk@ppc.at
MAIL_NOTICE_DIGEST=
MAIL_NOTICE_DIGEST_HOUR=7
MAIL_SMTP_LOGIN=none
MAIL_SMTP_PASSWD=
MAIL_SMTP_PORT=25
MAIL_SMTP_SERVER=127.0.0.1
MAIL_SMTP_TO=helpdesk@ppc.at
MAIL_SMTP_USER=
MAILCHECK_AI_MODEL=gemma4:12b
MAILCHECK_AI_URL=http://192.168.191.131:11434
MCP_SERVICE_TOKEN=
ONCALL_EMAIL=
PUBLIC_ORIGIN=https://helpdesk.kmbcloud.at
SEARCH_AI_API_KEY=
SEARCH_AI_AUTO_REPLY_CATEGORIES=
SEARCH_AI_AVV_REFERENCE=
SEARCH_AI_ENDPOINT=
SEARCH_AI_PROVIDER=grok
SEARCH_AI_REGION=
SEARCH_MODEL_API_ID=
SEARCH_MODEL_API_KEY=
SEARCH_MODEL_CALL=
SEARCH_MODEL_INTERFACE=
SEARCH_MODEL_NAME=
SEARCH_MODEL_PASSWORD=
SEARCH_MODEL_URL=
SEARCH_MODEL_USER=
SESSION_SECRET=
SYSLOG_FACILITY=local0
SYSLOG_HOST=192.168.191.215
SYSLOG_NAME=KMBHelp
SYSLOG_PORT=514
SYSLOG_UTC_OFFSET=+01:00
TICKET_ARCHIVE_DIR=/var/lib/kmbhelp/archiv
TICKET_FILE_MAX_BYTES=10485760
TICKET_FILE_TYPES=png, jpg, jpeg, gif, webp, bmp, tif, tiff, pdf, docx, xlsx, pptx, txt, csv, md
VITE_PUBLIC_URL_HOME=https://home.kmbcloud.at
VITE_PUBLIC_URL_WIKI=https://wiki.kmbcloud.at
VITE_PUBLIC_URL_WWW=https://kmb-steuerberatung.at
WEBAUTHN_ORIGIN=https://helpdesk.kmbcloud.at
WEBAUTHN_RP_ID=helpdesk.kmbcloud.at
WORKER_SCHEDULE=00:00-08:00=30,08:00-17:00=10,17:00-24:00=30
