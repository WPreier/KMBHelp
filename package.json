{
  "name": "kmbhelp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.19.0",
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @kmbhelp/api --filter @kmbhelp/web dev",
    "dev:api": "pnpm --filter @kmbhelp/api dev",
    "dev:web": "pnpm --filter @kmbhelp/web dev",
    "dev:worker": "pnpm --filter @kmbhelp/worker dev",
    "test": "pnpm --filter \"./apps/*\" --filter \"./packages/*\" test",
    "typecheck": "pnpm --filter \"./apps/*\" --filter \"./packages/*\" typecheck && tsc -p tsconfig.scripts.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "pnpm --filter @kmbhelp/db db:migrate",
    "db:seed": "pnpm --filter @kmbhelp/db db:seed",
    "db:generate": "pnpm --filter @kmbhelp/db db:generate",
    "install:helpdesk": "tsx scripts/install.ts"
  },
  "devDependencies": {
    "@kmbhelp/db": "workspace:*",
    "@kmbhelp/shared": "workspace:*",
    "@eslint/js": "^9.39.1",
    "@types/node": "catalog:",
    "eslint": "^9.39.1",
    "prettier": "^3.6.2",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "^8.46.2"
  }
}
